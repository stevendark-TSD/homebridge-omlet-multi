{
  "pluginAlias": "OmletMulti",
  "pluginType": "platform",
  "singular": true,
  "customUi": true,
  "schema": {
    "type": "object",
    "required": [
      "name",
      "countryCode"
    ],
    "properties": {
      "name": {
        "title": "Name",
        "type": "string",
        "default": "Omlet",
        "description": "Name for this plugin instance"
      },
      "email": {
        "title": "Email Address",
        "type": "string",
        "format": "email",
        "description": "Your Omlet account email address"
      },
      "password": {
        "title": "Password",
        "type": "string",
        "description": "Your Omlet account password"
      },
      "countryCode": {
        "title": "Country Code",
        "type": "string",
        "default": "US",
        "enum": [
          "AU",
          "DE",
          "DK",
          "ES",
          "FR",
          "GB",
          "IE",
          "IT",
          "NL",
          "NO",
          "PL",
          "SE",
          "US"
        ],
        "description": "Your country"
      },
      "apiServer": {
        "title": "API Server",
        "type": "string",
        "default": "x107.omlet.co.uk",
        "description": "Omlet API server hostname (default is x107.omlet.co.uk)"
      },
      "authMethod": {
        "title": "Connection Method",
        "type": "string",
        "default": "key",
        "enum": [
          "key",
          "account"
        ],
        "description": "Which setup method the plugin settings page should open on. Set automatically; not used at runtime."
      },
      "bearerToken": {
        "title": "Developer API Key",
        "type": "string",
        "description": "Your Omlet API key. Generate one in the developer console at smart.omlet.com/developers, or leave blank and log in with your email address and password to have one issued for you. Letters, digits, underscores and hyphens, no longer than 128 characters."
      },
      "pollInterval": {
        "title": "Poll Interval (seconds)",
        "type": "integer",
        "default": 30,
        "minimum": 30,
        "description": "How often to check device status (30-300 seconds)"
      },
      "excludeDevices": {
        "title": "Hidden Devices",
        "type": "array",
        "items": {
          "type": "string",
          "title": "Device ID",
          "pattern": "^[a-zA-Z0-9]{1,32}$"
        },
        "description": "Device IDs to leave out of HomeKit. Every coop door and feeder on your account is added unless listed here."
      },
      "feedLowThreshold": {
        "title": "Feed Low Threshold (%)",
        "type": "integer",
        "default": 20,
        "minimum": 0,
        "maximum": 100,
        "description": "Feeders report Feed Low below this level"
      },
      "debug": {
        "title": "Debug Mode",
        "type": "boolean",
        "default": false,
        "description": "Enable detailed logging for troubleshooting"
      },
      "enableLight": {
        "title": "Coop Light Accessories",
        "type": "string",
        "default": "auto",
        "oneOf": [
          {
            "title": "Auto-discover",
            "enum": [
              "auto"
            ]
          },
          {
            "title": "Do not display",
            "enum": [
              "off"
            ]
          }
        ]
      },
      "enableBattery": {
        "title": "Battery Status",
        "type": "string",
        "default": "auto",
        "oneOf": [
          {
            "title": "Automatic by power type",
            "enum": [
              "auto"
            ]
          },
          {
            "title": "Always show",
            "enum": [
              "on"
            ]
          },
          {
            "title": "Always hide",
            "enum": [
              "off"
            ]
          }
        ]
      }
    }
  },
  "layout": [
    "name",
    "bearerToken",
    "email",
    "password",
    "countryCode",
    {
      "type": "fieldset",
      "title": "Advanced Settings",
      "expandable": true,
      "expanded": false,
      "items": [
        "apiServer",
        "pollInterval",
        "excludeDevices",
        "feedLowThreshold",
        "enableLight",
        "enableBattery",
        "debug"
      ]
    }
  ]
}
